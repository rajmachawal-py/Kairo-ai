# ── iNSIGHTS environment variables ──

# Google Gemini (get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Generic LLM fallback (optional)
LLM_API_KEY=
LLM_BASE_URL=

# Tavily (web search)
TAVILY_API_KEY=

# GitHub
GITHUB_TOKEN=

# NewsAPI
NEWSAPI_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# PostgreSQL (local install or cloud)
POSTGRES_USER=insights
POSTGRES_PASSWORD=insights
POSTGRES_DB=insights
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Or set this directly to override individual Postgres fields:
# DATABASE_URL=postgresql+asyncpg://insights:insights@localhost:5432/insights

# Backend
SECRET_KEY=change-me-in-production
